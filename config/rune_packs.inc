; Data-only rune pack table (generated by gen_bank0.py). Do not edit by hand.
; One line per pack: first rune ID, number of cells, file name inside ..\assets\.
; Cell N of a file is rune ID (first + N) in bank 0. Format: lib/rune/pack_format.inc,
; which must be included first (it defines the rune_pack macro).
; No section directive: include inside the .data section.

align 4
rune_pack_table:
    rune_pack 0x00,  3, 'space.bin'
    rune_pack 0x10,  8, 'control.bin'
    rune_pack 0x30, 10, 'digits.bin'
    rune_pack 0x40, 11, 'math.bin'
    rune_pack 0x50, 26, 'punctuation.bin'
    rune_pack 0x80, 26, 'uppercase.bin'
    rune_pack 0xA0, 26, 'lowercase.bin'
rune_pack_table_end:
assert (rune_pack_table_end - rune_pack_table) = 7 * RUNE_PACK_ENTRY_BYTES
