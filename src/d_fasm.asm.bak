; File: src/d_fasm.asm
; Step 1 of the DisplaySurface: one hard-set DisplaySurface (ds_0),
; except Esc.
 
format PE64 GUI 5.0
entry start
 
; Machine-specific paths live in build.bat (it sets the INCLUDE variable
; that FASM searches). Project files are found relative to this file.
include 'win64w.inc'
include '../lib/spatial.inc'
 
section '.data' data readable writeable
    _class        TCHAR 'DHostClass', 0
    _title        TCHAR 'D', 0
    _error        TCHAR 'Host startup failed.', 0
    _message_error TCHAR 'Message retrieval failed.', 0
    _rune_pack_error TCHAR 'Rune pack missing or invalid.', 0
 
    ; --- DisplaySurface 0 ----------------------------------------------------
    ; Geometry is filled from the primary monitor at startup.
    align 32
    ds_0:
        dd 0, 0, 0              ; x, y, z
        dd 0, 0, 1              ; w, h, d
		dd 0xFF1E1E2E           ; background color 0xFF0B3D2E or 0xFF1E1E2E
        dd 0                    ; spare
 
    align 8
    buffer_bytes  dq 0          ; w * h * 4
 
include '../lib/win64_host.inc'
include '../lib/draw2d.inc'
include '../lib/rune/layout_format.inc'
include '../lib/rune/pack_format.inc'
include '../lib/rune/rune_constants.inc'
include '../config/layout_en_us.inc'
include '../config/rune_packs.inc'
include '../lib/rune/rune_state.inc'
include '../lib/rune/rune_loader.inc'
include '../lib/rune/rune_bank.inc'
include '../lib/rune/rune_draw.inc'
include '../lib/rune/rune_input.inc'
 
section '.text' code readable executable
start:
    sub rsp, 40                 ; shadow space + 16-byte alignment
 
    ; 1. Select the primary monitor (the monitor containing desktop origin)
    ;    and copy its current bounds into DisplaySurface 0.
    invoke MonitorFromPoint, 0, 1 ; POINT(0,0), MONITOR_DEFAULTTOPRIMARY
    test rax, rax
    jz .failed
    invoke GetMonitorInfo, rax, monitor_info
    test eax, eax
    jz .failed

    mov eax, [monitor_info + DS_MONITORINFO_LEFT]
    mov [ds_0 + AREA_X], eax
    mov eax, [monitor_info + DS_MONITORINFO_TOP]
    mov [ds_0 + AREA_Y], eax
    mov eax, [monitor_info + DS_MONITORINFO_RIGHT]
    sub eax, [monitor_info + DS_MONITORINFO_LEFT]
    test eax, eax
    jle .failed
    mov [ds_0 + AREA_W], eax
    mov eax, [monitor_info + DS_MONITORINFO_BOTTOM]
    sub eax, [monitor_info + DS_MONITORINFO_TOP]
    test eax, eax
    jle .failed
    mov [ds_0 + AREA_H], eax

    ; 2. Frame buffer size from ds_0
    mov eax, [ds_0 + AREA_W]
    imul eax, [ds_0 + AREA_H]
    shl rax, 2                  ; 4 bytes per pixel
    mov [buffer_bytes], rax
 
    ; 3. Bitmap header: width, and negative height for top-down rows
    mov eax, [ds_0 + AREA_W]
    mov [bmi + 4], eax
    mov eax, [ds_0 + AREA_H]
    neg eax
    mov [bmi + 8], eax
 
    ; 4. Module handle, cursor, window class
    invoke GetModuleHandle, 0
    mov [hinstance], rax
    mov [wc.hInstance], rax
 
    invoke LoadCursor, 0, IDC_ARROW
    mov [wc.hCursor], rax
 
    invoke RegisterClassEx, wc
    test rax, rax
    jz .failed
 
    ; 5. Frame buffer (zeroed by HEAP_ZERO_MEMORY = 8)
    invoke GetProcessHeap
    invoke HeapAlloc, rax, 8, [buffer_bytes]
    mov [pixel_buffer], rax
    test rax, rax
    jz .failed

    ; 6. Load the independent bracket mask pack and prepare its white palette.
    call BuildCoveragePalette
    call LoadRunePacks
    test eax, eax
    jz .rune_pack_failed
 
    ; 7. Fill ds_0 with its own color. Buffer coordinates start at 0,0;
    ;    ds_0's x,y place the host on the virtual desktop, not in the buffer.
    movsxd r11, dword [ds_0 + AREA_W]
    movsxd r12, dword [ds_0 + AREA_H]
    mov edx, [ds_0 + AREA_COLOR]
    draw_rect_block pixel_buffer, r11, 0, 0, r11, r12, edx
	call RefreshBankIndicator
 
    ; 8. Host window: borderless, exactly covering ds_0
    movsxd rbx, dword [ds_0 + AREA_X]
    movsxd rsi, dword [ds_0 + AREA_Y]
    movsxd r11, dword [ds_0 + AREA_W]
    movsxd r12, dword [ds_0 + AREA_H]
    invoke CreateWindowEx, \
           0, _class, _title, WS_POPUP or WS_VISIBLE, \
           rbx, rsi, r11, r12, \
           0, 0, [hinstance], 0
    test rax, rax
    jz .failed
    mov [hwnd], rax
 
    invoke ShowWindow, [hwnd], SW_SHOWNORMAL
    invoke UpdateWindow, [hwnd]
 
.msg_loop:
    invoke GetMessage, msg, 0, 0, 0
    cmp eax, -1
    je .message_error
    test rax, rax
    jz .exit
    invoke TranslateMessage, msg
    invoke DispatchMessage, msg
    jmp .msg_loop

.message_error:
    invoke MessageBox, 0, _message_error, _title, MB_OK or MB_ICONERROR
    invoke ExitProcess, 1
 
.rune_pack_failed:
    invoke MessageBox, 0, _rune_pack_error, _title, MB_OK or MB_ICONERROR
    invoke ExitProcess, 1

.failed:
    invoke MessageBox, 0, _error, _title, MB_OK or MB_ICONERROR
.exit:
    invoke ExitProcess, 0
 
section '.idata' import data readable
    library kernel32, 'KERNEL32.DLL', \
            user32,   'USER32.DLL', \
            gdi32,    'GDI32.DLL'
 
    include 'API\KERNEL32.INC'
    include 'API\USER32.INC'
    include 'API\GDI32.INC'
