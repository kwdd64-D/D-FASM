; File: lib/rune/layout_format.inc
; The shared contract for the key-layout table: config/layout_en_us.inc, which is
; GENERATED by utils/python/gen_bank0.py (write_layout). Constants only, no code or data.
;
; Each entry is LAYOUT_ENTRY_SIZE bytes:
;   +0  word  Win32 virtual key
;   +2  byte  modifier mask (LAYOUT_MOD_* bits that must match exactly)
;   +3  byte  rune ID
;
; If this format ever changes, change it here, in HandleRuneKey (rune_input.inc),
; and in write_layout (gen_bank0.py) together.

LAYOUT_ENTRY_SIZE = 4
LAYOUT_OFF_VK     = 0
LAYOUT_OFF_MOD    = 2
LAYOUT_OFF_RUNE   = 3

LAYOUT_MOD_SHIFT  = 1
LAYOUT_MOD_CTRL   = 2
