; File: lib/rune/pack_format.inc
; The shared contract for the pack table: config/rune_packs.inc, which is GENERATED by
; utils/python/gen_bank0.py (write_packs). Holds the entry format constants and the
; rune_pack macro. No data of its own is emitted until the table is included.
;
; Each table entry is RUNE_PACK_ENTRY_BYTES bytes:
;   +0  dword  first rune ID
;   +4  dword  number of cells
;   +8  RUNE_NAME_CHARS wide chars  filename inside ..\assets\ (zero padded)
; LoadRunePacks reads the table through this layout.
;
; If this format changes, change it here, in LoadRunePacks (rune_loader.inc), and in
; write_packs (gen_bank0.py) together. Include this file BEFORE config/rune_packs.inc.

RUNE_CELL_BYTES = 1024                 ; one cell: 32x32 pixels, one byte of coverage each

RUNE_ASSETS_PREFIX_CHARS = 10          ; length of '..\assets\' (without the NUL)
RUNE_NAME_CHARS           = 16         ; each pack filename field: 15 chars + NUL
RUNE_PACK_ENTRY_BYTES     = 8 + RUNE_NAME_CHARS * 2

; Running total of cells across every rune_pack line. The pool is sized from
; this (see rune_bss.inc), so adding or resizing a pack needs no other edit.
rune_pool_cells = 0

; One loadable pack: first rune ID, number of cells, filename (in ..\assets\).
; Cell N of the file is rune ID (first + N) in bank 0.
macro rune_pack first, count, name {
    local s, e
    rune_pool_cells = rune_pool_cells + count
    dd first, count
    s du name, 0
    e:
    db RUNE_NAME_CHARS * 2 - (e - s) dup 0
}
