; File: lib/keys.inc
; Win32 virtual-key codes used by the project. Constants only: no code, no data.
; One home for every key code, so no file defines its own copy.

KEY_ESCAPE  = 0x1B
KEY_SHIFT   = 0x10
KEY_CONTROL = 0x11
KEY_CAPITAL = 0x14          ; Caps Lock
KEY_SCROLL  = 0x91          ; Scroll Lock
