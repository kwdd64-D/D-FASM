; File: lib/win64_host.inc
; Windows x64 host: the one OS window that covers a DisplaySurface, plus the
; message handler that presents the frame buffer. The model (surfaces,
; workspaces, anchors, regions) never sees an HWND; only this file does.
 
 
DIB_RGB_COLORS = 0
SW_SHOWNORMAL  = 1
CS_VREDRAW     = 1
CS_HREDRAW     = 2
WM_KEYDOWN     = 0x0100
VK_ESCAPE      = 0x1B
 
; MONITORINFO layout: cbSize followed by rcMonitor, rcWork, and dwFlags.
DS_MONITORINFO_LEFT   = 4
DS_MONITORINFO_TOP    = 8
DS_MONITORINFO_RIGHT  = 12
DS_MONITORINFO_BOTTOM = 16

section '.data' data readable writeable
    wc           WNDCLASSEX sizeof.WNDCLASSEX, CS_VREDRAW or CS_HREDRAW, WindowProc, 0, 0, 0, 0, 0, 0, 0, _class, 0
    msg          MSG
    ps           PAINTSTRUCT
    pixel_buffer dq 0
    hwnd         dq 0
    hinstance    dq 0
 
    align 4
    monitor_info:
        dd 40                ; sizeof(MONITORINFO)
        dd 0, 0, 0, 0        ; rcMonitor: left, top, right, bottom
        dd 0, 0, 0, 0        ; rcWork
        dd 0                 ; dwFlags

    align 8
    bmi:
        dd 40
        dd 0          ; width,  filled at startup from ds_0
        dd 0          ; height, filled at startup from ds_0 (negative = top-down)
        dw 1
        dw 32
        dd 0, 0, 0, 0, 0, 0, 0
 
section '.text' code readable executable
proc WindowProc uses rbx rsi rdi r12, hwnd, uMsg, wParam, lParam
    mov [hwnd], rcx
    mov [uMsg], rdx
    mov [wParam], r8
    mov [lParam], r9
 
    cmp edx, WM_PAINT
    je .on_paint
    cmp edx, WM_KEYDOWN
    je .on_keydown
    cmp edx, WM_DESTROY
    je .on_destroy
 
    invoke DefWindowProc, [hwnd], [uMsg], [wParam], [lParam]
    jmp .done
 
.on_keydown:
    ; TEMPORARY exit path: a full-surface white host has no close control.
    ; Remove once a region provides one. (Alt+F4 also works.)
    cmp qword [wParam], VK_ESCAPE
    jne .key_other
    invoke DestroyWindow, [hwnd]
    xor rax, rax
    jmp .done
.key_other:
    fastcall HandleRuneKey, [wParam]     ; local proc: direct call, not invoke
    test eax, eax
    jz .key_unhandled
    invoke InvalidateRect, [hwnd], 0, 0
    invoke UpdateWindow, [hwnd]
    xor rax, rax
    jmp .done
.key_unhandled:
    invoke DefWindowProc, [hwnd], [uMsg], [wParam], [lParam]
    jmp .done
 
.on_paint:
    invoke BeginPaint, [hwnd], ps
    mov r12, rax
    movsxd rbx, dword [ds_0 + AREA_W]
    movsxd rsi, dword [ds_0 + AREA_H]
    invoke StretchDIBits, r12, 0, 0, rbx, rsi, 0, 0, rbx, rsi, [pixel_buffer], bmi, DIB_RGB_COLORS, SRCCOPY
    invoke EndPaint, [hwnd], ps
    xor rax, rax
    jmp .done
 
.on_destroy:
    invoke PostQuitMessage, 0
    xor rax, rax
.done:
    ret
endp
